dules_to_layers(graph, list({id(s): s for s in sources}.values()))\nby_layer = {}; heads = {}\nfor nid, layer in alloc.items():\n    blk = graph.nodes[nid].get('MODEL_BLOCK')\n    if blk is None: continue\n    if isinstance(blk, transformers.MLP): by_layer[layer] = by_layer.get(layer, 0) + blk.fst.output_space.num_dims\n    elif isinstance(blk, transformers.SeriesWithResiduals):\n        for b in blk.blocks:\n            if isinstance(b, transformers.MLP): by_layer[layer+1] = by_layer.get(layer+1, 0) + b.fst.output_space.num_dims\n        heads.setdefault(layer, []).append(nid)\n    else: heads.setdefault(layer, []).append(nid)\nprint('layers', max(alloc.values())//2 + 1, 'max mlp', max(by_layer.values()), 'max heads', max(len(v) for v in heads.values()))\nprint(sorted((l, v) for l, v in heads.items() if len(v) > 2))\nprint(sorted((l, len(v)) for l, v in heads.items()))\n```","ttft_ms":35952,"type":"result","duration_ms":53975,"uuid":"1f1d5e8f-d326-4ed1-8bf9-9896cd0502c7","ttft_stream_ms":1004,"time_to_request_ms":64,"time_to_request_phases_ms":{"other":5,"system_prompt":2,"resume_other":0,"process_user_input":3,"input_attachments":8,"input_hooks":2,"conversation_append":2,"transcript_persist":1,"tool_pool_refresh":2,"init_message":2,"init_frame_send":0,"engine_pickup":1,"loop_entry":3,"message_prep":1,"model_config_wait":1,"autocompact":2,"request_announcements":4,"query_setup":1,"model_gates":0,"tool_schema_build":2,"message_normalization":6,"client_creation":5,"request_build":11},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":14,"time_to_request_cpu_ms":69,"time_to_request_major_faults":0,"process_rss_mib_turn_start":205,"process_anon_mib_turn_start":131,"process_rss_mib_result":200,"process_anon_mib_result":121,"process_peak_rss_mib":240,"process_cpu_ms_turn":999,"process_wall_ms_turn":53975,"process_cpu_ms_streaming":639,"process_wall_ms_streaming":51017,"main_stream_count":1,"main_stream_event_count":358,"main_stream_chunk