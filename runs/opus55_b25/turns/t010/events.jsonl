tus":null,"result":"```python\nimport time, signal\nfrom tracr.rasp import rasp\nfrom tracr.compiler import compiling\n\ndef handler(signum, frame): raise TimeoutError()\nsignal.signal(signal.SIGALRM, handler)\n\ndef build(n_seq, valsize):\n    a = rasp.categorical(rasp.Map(lambda i: i % valsize, rasp.indices))\n    b = rasp.categorical(rasp.Map(lambda i: (i * 7) % valsize, rasp.indices))\n    for it in range(n_seq):\n        c = rasp.categorical(rasp.SequenceMap(lambda x, y: min(x, y), a, b))\n        a, b = b, c\n    return rasp.numerical(rasp.Map(lambda v: v / 82, b))\n\nfor n_seq, vs in [(1, 20), (1, 40), (2, 40)]:\n    signal.alarm(250)\n    t = time.time()\n    try:\n        m = compiling.compile_rasp_to_model(build(n_seq, vs), vocab={\".\", \"x\", \"o\", \"B\", \"W\"}, max_seq_len=82, compiler_bos=\"BOS\", mlp_exactness=100)\n        print(n_seq, vs, 'ok', time.time() - t, m.model_config.mlp_hidden_size, len(m.residual_labels))\n    except TimeoutError:\n        print(n_seq, vs, 'timeout', time.time() - t)\n    signal.alarm(0)\n```","ttft_ms":6154,"type":"result","duration_ms":12941,"uuid":"f6e28f67-08e6-494b-bfd6-a25f4a085a1b","ttft_stream_ms":605,"time_to_request_ms":67,"time_to_request_phases_ms":{"other":6,"system_prompt":2,"resume_other":0,"process_user_input":4,"input_attachments":7,"input_hooks":4,"conversation_append":1,"transcript_persist":1,"tool_pool_refresh":2,"init_message":2,"init_frame_send":1,"engine_pickup":2,"loop_entry":3,"message_prep":1,"model_config_wait":3,"autocompact":2,"request_announcements":3,"query_setup":0,"model_gates":1,"tool_schema_build":2,"message_normalization":5,"client_creation":6,"request_build":9},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":16,"time_to_request_cpu_ms":71,"time_to_request_major_faults":0,"process_rss_mib_turn_start":197,"process_anon_mib_turn_start":124,"process_rss_mib_result":195,"process_anon_mib_result":116,"process_peak_rss_mib":215,"process_cpu_ms_turn":628,