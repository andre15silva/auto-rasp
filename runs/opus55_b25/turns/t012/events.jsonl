:null,"result":"```python\nimport time, signal\nfrom tracr.rasp import rasp\nfrom tracr.compiler import compiling\n\ndef handler(signum, frame): raise TimeoutError()\nsignal.signal(signal.SIGALRM, handler)\n\ndef build(n_seq, valsize):\n    t0 = rasp.categorical(rasp.Map(lambda t: 0 if t == '.' else 1, rasp.tokens))\n    a = rasp.categorical(rasp.Map(lambda i: i % valsize, rasp.indices))\n    b = rasp.categorical(rasp.Map(lambda i: (i*7) % valsize, rasp.indices))\n    for it in range(n_seq):\n        c = rasp.categorical(rasp.SequenceMap(lambda x, y: min(x, y), a, b))\n        a, b = b, c\n    c = rasp.categorical(rasp.SequenceMap(lambda x, y: x+y, b, t0))\n    return rasp.numerical(rasp.Map(lambda v: v / 82, c))\n\nfor n_seq, vs in [(1, 30), (1, 50), (1,70)]:\n    signal.alarm(280)\n    t = time.time()\n    try:\n        m = compiling.compile_rasp_to_model(build(n_seq, vs), vocab={\".\", \"x\", \"o\", \"B\", \"W\"}, max_seq_len=82, compiler_bos=\"BOS\", mlp_exactness=100)\n        print(n_seq, vs, 'ok', time.time() - t, m.model_config.mlp_hidden_size, len(m.residual_labels))\n    except TimeoutError:\n        print(n_seq, vs, 'timeout', time.time() - t)\n    signal.alarm(0)\n```","ttft_ms":2207,"type":"result","duration_ms":10140,"uuid":"763c610d-7c00-4e8f-91ef-6c926a2ffaf8","ttft_stream_ms":645,"time_to_request_ms":79,"time_to_request_phases_ms":{"other":8,"system_prompt":2,"resume_other":1,"process_user_input":3,"input_attachments":7,"input_hooks":2,"conversation_append":1,"transcript_persist":2,"tool_pool_refresh":3,"init_message":6,"init_frame_send":1,"engine_pickup":1,"loop_entry":4,"message_prep":4,"model_config_wait":1,"autocompact":2,"request_announcements":4,"query_setup":0,"model_gates":1,"tool_schema_build":3,"message_normalization":7,"client_creation":4,"request_build":12},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":29,"time_to_request_cpu_ms":69,"time_to_request_major_faults":0,"process_rss_mib_turn_start":192,"